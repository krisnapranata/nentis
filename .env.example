# Salin file ini menjadi `.env` lalu isi nilai sebenarnya.
# JANGAN commit `.env` ke git.

# Django
SECRET_KEY=ganti-dengan-secret-key-random
DEBUG=True
ALLOWED_HOSTS=*
# CSRF_TRUSTED_ORIGINS=https://nentis.example.com
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Database
DB_NAME=nentis
DB_USER=sik
DB_PASSWORD=00
DB_HOST=localhost
DB_PORT=3306

# MySQL root (untuk container docker)
MYSQL_ROOT_PASSWORD=ganti-dengan-password-root

# Akun default (dibuat oleh seed_data)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password
ADMISI_USERNAME=admisi
ADMISI_PASSWORD=ganti-password
DOKTER_USERNAME=dokter
DOKTER_PASSWORD=ganti-password
